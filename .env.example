# ─────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────
APP_NAME=DentaSaaS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://clinic.designflowstudio.space

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─────────────────────────────────────────────────────────────
# Database (MySQL) — required. Run `php artisan migrate:fresh --seed` after setup.
# ─────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dentasaas
DB_USERNAME=root
DB_PASSWORD=

# ─────────────────────────────────────────────────────────────
# Session / Cache / Queue — database-backed by default.
# Dashboard stats, analytics and plan-usage are cached for 10 minutes;
# switch CACHE_STORE to redis in production for lower latency.
# ─────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─────────────────────────────────────────────────────────────
# Mail — used for WelcomeMail, AccessRequestMail, PlanExpiredMail.
# Set MAIL_MAILER=log locally to inspect emails in storage/logs instead of sending.
# ─────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@dentasaas.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────
# File storage (AWS S3) — only needed if FILESYSTEM_DISK=s3.
# Clinic logo uploads default to the local `public` disk (storage/app/public,
# served via the `php artisan storage:link` symlink).
# ─────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
